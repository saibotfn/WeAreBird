--- !u!114 &686785893
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 686785892}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 008d1f774e0e642babcaf796acfe31ef, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  npcName: Onkel
  questDialogues:
  - requiredStage: 0
    dialogueLines:
    - "Dine fjer er virkelig vokset de sidste \xE5r og vi f\xF8ler i familien, at
      du er klar til at tr\xE6de ind i forretningen."
    - "Jeg har den her pakke du skal levere. - Ikke t\xE6nk over hvad der er i den.
      Pakken er ovre p\xE5 taget af bageriet. N\xE5r du har hentet den, skal du m\xF8des
      med F\xE6tter p\xE5 den h\xF8jeste bygning i byen og han giver dig videre instrukser."
    - "Inden du tager afsted, s\xE5 tag lige en flyvetur over til toppen af den gr\xF8nne
      bygning bag mig og tilbage for at varme fjerene op"
    advanceQuestOnCompletion: 1
    nextStage: 1
  - requiredStage: 2
    dialogueLines:
    - Okay, du er klar nu.
    - Hey - Fokuser! *Onkel giver dig en lille flad*
    - "Opgaven er ligetil. Du flyver over p\xE5 taget af bageriet og henter pakken
      og derfra videre til den h\xF8jeste bygning i byen."
    - Afsted med dig!
    advanceQuestOnCompletion: 1
    nextStage: 3
  - requiredStage: 6
    dialogueLines:
    - Hold da op!!!
    - "Du kunne m\xE5ske en dag blive en rigtig crime bird"
    advanceQuestOnCompletion: 1
    nextStage: 7
  interactionDistance: 3
  player: {fileID: 678008492}
  dialogueManager: {fileID: 1682267039}
